# Kopiere diese Datei nach .env und fülle sie aus.
# Start:  node --env-file=.env watcher.mjs

# --- Zugang (Pflicht) ---
# Die cookie-Zeile von api.unicacity.eu. Damit holt sich der Watcher
# fortlaufend frische Token. Siehe README, Abschnitt "Zugang besorgen".
UC_COOKIE=""

# --- Push ---
UC_NTFY_TOPIC=

# --- Schwellwerte ---
UC_LAGER_SCHWELLE=500
# Plötzlicher Lagerverlust ab X % gilt als Vorfall (Einbruch o.ä.)
UC_LAGER_EINBRUCH_PCT=15
# Sprung der Einkaufspreise, ab dem ein Lieferengpass vermutet wird
UC_PREIS_SPRUNG_PCT=20

# --- Wiki ---
UC_WIKI=1
UC_WIKI_INTERVALL_STD=24

# --- Notion-Abgleich (optional) ---
# Zugangsschlüssel einer Notion-Integration, siehe README
UC_NOTION_TOKEN=
UC_NOTION_WIKI=3c4a6c9607aa80ef9ca5c6658d04c349
# Grundtakt in Stunden; nach jeder Wiki-Änderung wird zusätzlich sofort geprüft
UC_NOTION_INTERVALL_STD=168
UC_ERINNERUNG_MIN=60
UC_AUSSCHUETTUNG_STD=12
UC_AUSSCHUETTUNG_STUNDENMELDUNG=1
# Tagesbericht um 04:00: wer war wie lange online (0 = aus)
UC_TAGESBERICHT=1
# Ab wie vielen Minuten Ausfall gemeldet wird, dass die Seite nicht antwortet
UC_API_WEG_MELDUNG_MIN=30

# --- Betrieb ---
UC_INTERVALL_MS=60000
UC_LUECKE_MIN=10
UC_TAGESWECHSEL_STD=4
UC_TOKEN_PUFFER_MIN=5
UC_STATE_FILE=./uc-watcher-state.json
UC_DEBUG=0
