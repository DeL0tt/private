# Kopiere diese Datei nach .env und fülle sie aus.
# Start:  node --env-file=.env watcher.mjs

# --- Zugang (Pflicht) ---
# Die cookie-Zeile von api.unicacity.eu. Damit holt sich der Watcher
# fortlaufend frische Token. Siehe README, Abschnitt "Zugang besorgen".
UC_COOKIE=""

# --- Push ---
UC_NTFY_TOPIC=

# --- Schwellwerte ---
UC_LAGER_SCHWELLE=500
# Wie lange nach dem letzten Einkauf der Nachkauf als laufend gilt
UC_NACHKAUF_FENSTER_MIN=90
# Duerfen alle Kassenstaende, Betraege und Anwesenheitslisten sehen? 1 = ja.
# Mit 0 bekommen geteilte Kanaele gekuerzte Meldungen und /kasse sowie
# /tagesbericht sind dem Inhaber vorbehalten.
UC_ZAHLEN_OFFEN=1
# Verwaltungsbefehle vor den uebrigen verbergen (1 = ja). Discord zeigt sonst
# jedem alle Befehle samt Beschreibung, auch wenn der Bot sie verweigert.
UC_DISCORD_BEFEHLE_VERBERGEN=1
# Mindestabstand zwischen zwei Befehlen derselben Person, in Sekunden.
# Jeder Befehl fragt UnicaCity mit deinem Zugang ab; 0 schaltet die Bremse ab.
UC_DISCORD_BEFEHL_PAUSE_S=5
# Bleibt ein Vorfall offen: nach so vielen Minuten nachfassen. 0 = nie, so
# voreingestellt. Einschalten am besten im Discord ueber /melden.
UC_VORFALL_ERINNERUNG_MIN=0
UC_VORFALL_ERINNERUNG_MAX=3
# Startliste der Vorfallsarten fuer die Auswahl in /melden. Was der Watcher
# selbst sieht, kommt automatisch dazu.
UC_VORFALL_ARTEN=ABWERBUNG,RAZZIA,UEBERFALL,EINBRUCH,DIEBSTAHL,SABOTAGE,STEUERPRUEFUNG,LIEFERENGPASS
# Plötzlicher Lagerverlust ab X % gilt als Vorfall (Einbruch o.ä.)
UC_LAGER_EINBRUCH_PCT=15
# Sprung der Einkaufspreise, ab dem ein Lieferengpass vermutet wird
UC_PREIS_SPRUNG_PCT=20

# --- Wiki ---
UC_WIKI=1
UC_WIKI_INTERVALL_STD=24

# --- Notion-Abgleich (optional) ---
# Zugangsschlüssel einer Notion-Integration, siehe README
UC_NOTION_TOKEN=
UC_NOTION_WIKI=3c4a6c9607aa80ef9ca5c6658d04c349
# Grundtakt in Stunden; nach jeder Wiki-Änderung wird zusätzlich sofort geprüft
UC_NOTION_INTERVALL_STD=168
UC_ERINNERUNG_MIN=60
UC_AUSSCHUETTUNG_STD=12
UC_AUSSCHUETTUNG_STUNDENMELDUNG=1
# Tagesbericht um 04:00: wer war wie lange online (0 = aus)
UC_TAGESBERICHT=1
# Ab wie vielen Minuten Ausfall gemeldet wird, dass die Seite nicht antwortet
UC_API_WEG_MELDUNG_MIN=30
# --- Betrieb (Zoohandlung), siehe /betrieb ---
# Name des beobachteten Betriebs
UC_BETRIEB=Zoohandlung
# Besser als der Name: die ID aus dem Dashboard (z. B. 35). Ist sie gesetzt,
# wird der Bestand genau dieses Betriebs gelesen und UC_BETRIEB_ABZUG entfaellt.
UC_BETRIEB_ID=
# Nur noetig, wenn statt eines Betriebs eine Gesamtsumme ausgewertet wird.
# Mit UC_BETRIEB_ID wird ohnehin nichts abgezogen.
UC_BETRIEB_ABZUG=0
# Hoechster entnehmbarer Bestand (fuer den Balken)
UC_BETRIEB_MAX=240
# Ab wann gewarnt wird
UC_BETRIEB_SCHWELLE=40
# Die Daten stehen in /api/panel/me; nur setzen, wenn sich das aendert
UC_BETRIEB_PFAD=

# Tagesbudget fuer Auszahlungen und Gehaelter, siehe /gehalt
UC_AUSZAHLUNG_LIMIT=35000
# Wann es zurueckgesetzt wird. 0 = Mitternacht. Nicht mit dem Spieltag
# verwechseln, der um 04:00 wechselt (UC_TAGESWECHSEL_STD).
UC_AUSZAHLUNG_RESET_STD=0
# Welche Buchungskategorien daran zehren
UC_AUSZAHLUNG_KATEGORIEN=auszahlung,gehalt
# Unbekannte Buchungen melden (1 = an). Standard aus, war vor allem Laerm.
UC_UNBEKANNTE_BUCHUNGEN=0

# --- Discord (optional, siehe DISCORD.md) ---
# Ohne Token bleibt der Bot aus und Meldungen gehen nur an ntfy.
UC_DISCORD_TOKEN=
UC_DISCORD_GUILD=
# Kanal fuer die Angestellten: Lager, Lieferengpass, Firma pausiert, Ausschuettung
UC_DISCORD_TEAM_KANAL=
# Kanal, den nur du sehen kannst: Geld, Personal, Zeiten, Zugang, Technik
UC_DISCORD_CHEF_KANAL=
# Kanal fuer Vorfaelle (optional). Ist er gesetzt, gehen Vorfall, Kassenvorfall
# und unbekannte Buchung dorthin - gekuerzt - und zusaetzlich vollstaendig an
# dich. Ohne ihn bleibt es bei der Voreinstellung.
UC_DISCORD_VORFALL_KANAL=
# Kanal fuer Befehle: dort sind Antworten fuer alle sichtbar statt nur fuer den
# Fragenden - gilt nur fuer /firma, /lager, /ausschuettung, /zeiten, /gehalt.
# Vorbehaltene Befehle antworten ueberall privat.
UC_DISCORD_BEFEHL_KANAL=
# Deine Discord-Nutzer-ID; daran erkennt der Bot dich bei den Befehlen.
# Ohne CHEF_KANAL gehen die Inhaber-Meldungen als DM an diese ID.
UC_DISCORD_CHEF_ID=
# Ersetzt die Team-Liste komplett, z. B. lager,event_ (optional)
UC_DISCORD_TEAM_THEMEN=
# Discord-Konto zu UC-Spielernamen, damit /zeiten jedem seine Zeit zeigt
UC_DISCORD_SPIELER=

# --- Betrieb ---
UC_INTERVALL_MS=60000
UC_LUECKE_MIN=10
UC_TAGESWECHSEL_STD=4
UC_TOKEN_PUFFER_MIN=5
UC_STATE_FILE=./uc-watcher-state.json
# Zeitarchiv: pro Spieltag die Onlinezeiten je Spieler samt Rolle, die
# Laufzeit der Firma, die Ausschuettungen und der Freibetrag. Getrennt vom
# Zustand, weil der seine Tageszaehler um 04:00 vergisst. Grundlage fuer
# /tagesbericht (auch vergangene Tage) und /woche.
UC_ARCHIV_FILE=./uc-watcher-zeiten.json
# Wie viele Spieltage aufgehoben werden
UC_ARCHIV_TAGE=400
# UC_ARCHIV=0 schaltet das Archiv ab (dann kein /woche und kein Rueckblick)
UC_DEBUG=0
